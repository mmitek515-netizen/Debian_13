{
  "openapi": "3.0.3",
  "info": {
    "title": "Debian 13 — GPT Actions",
    "version": "0.2.0",
    "description": "Authenticated operator-approved access to live Debian 13 API. Includes read-only Work queue and original-agent registry diagnostics; no task execution or proof of autonomous AI. Requires an independently deployed HTTPS reverse proxy and operator consent."
  },
  "servers": [
    {
      "url": "https://debian13.example.com",
      "description": "REPLACE with your own HTTPS domain before importing"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use the DEBIAN13_API_TOKEN as an API-key Bearer credential. Never paste it into the schema."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "profile",
          "message"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "alex",
              "aria",
              "astyria",
              "aurelius"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  },
  "paths": {
    "/v1/profiles": {
      "get": {
        "operationId": "listDebian13Agents",
        "summary": "List configured agent profiles, not background worker claims",
        "responses": {
          "200": {
            "description": "Profiles and provider configuration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "profiles": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "providerConfigured": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/integrations": {
      "get": {
        "operationId": "getDebian13Integrations",
        "summary": "Get actual configuration states of MCP, Codex, GPT Actions",
        "responses": {
          "200": {
            "description": "Integration statuses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "integrations": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/diagnostics": {
      "get": {
        "operationId": "getDebian13Diagnostics",
        "summary": "Get authenticated process diagnostics",
        "responses": {
          "200": {
            "description": "Read-only diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "operationId": "sendDebian13AgentMessage",
        "summary": "Send a text message to a selected configured provider model",
        "description": "Requires configured reachable model. Does not create a background agent or execute commands.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Real model answer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Model is not configured or unavailable"
          }
        }
      }
    },
    "/api/v1/original-agents": {
      "get": {
        "operationId": "getDebian13OriginalAgents",
        "summary": "Read observed source registry status of the four original agents",
        "description": "Returns source profile metadata and whether the original registry is configured/reachable. connected and workerVerified remain false until independently proven. Never infer real autonomous agent execution from source profiles or registry entries.",
        "responses": {
          "200": {
            "description": "Original agents and verified registry reachability; not a proof of inference",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "agents",
                    "registryConfigured",
                    "registryReachable",
                    "originalAgentExecutionVerified"
                  ],
                  "properties": {
                    "sourceRepository": {
                      "type": "string"
                    },
                    "registryConfigured": {
                      "type": "boolean"
                    },
                    "registryReachable": {
                      "type": "boolean"
                    },
                    "originalAgentExecutionVerified": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "connected": {
                            "type": "boolean"
                          },
                          "workerVerified": {
                            "type": "boolean"
                          },
                          "tasksInRegistry": {
                            "type": "integer"
                          },
                          "runningEntriesInRegistry": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "operationId": "listDebian13WorkQueue",
        "summary": "Read queued Work tasks, not evidence of executed AI tasks",
        "description": "Read-only listing of locally stored SQLite review tasks. A queued item and workersRunning field are observations, not proof that an agent worked or that GitHub PRs were created. This action cannot dispatch, cancel, create or approve tasks.",
        "responses": {
          "200": {
            "description": "Persisted Work task queue with execution labels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tasks",
                    "storage",
                    "workersRunning"
                  ],
                  "properties": {
                    "tasks": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "storage": {
                      "type": "string",
                      "enum": [
                        "sqlite"
                      ]
                    },
                    "workersRunning": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  }
}
